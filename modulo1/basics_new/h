fun main() {
    println("If con múltiples condiciones")
    println("Tiempo sala de espera")

    val tiempo = readLine()?.toIntOrNull() ?: 0

    val clasificacion = if (tiempo <= 10) {
        "Flujo normal"
    } else if (tiempo >= 11 && tiempo <= 30) {
        "Espera moderada - informar al paciente"
    } else if (tiempo >= 31 && tiempo <= 60) {
        "Espera prolongada - ofrecer reagendamiento"
    } else {
        "Alerta de gestión - notificar a coordinación"
    }

    println("Clasificación: $clasificacion")
}